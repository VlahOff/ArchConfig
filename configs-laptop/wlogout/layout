{
    "label": "lock",
    "action": "hyprlock & sleep 1 && hyprctl dispatch 'hl.dsp.dpms({ action = [[disable]] })'",
    "keybind": "l",
    "text": "Lock  ·  L"
}
{
    "label": "sleep",
    "action": "systemctl suspend",
    "keybind": "h",
    "text": "Sleep  ·  H"
}
{
    "label": "logout",
    "action": "loginctl kill-session $XDG_SESSION_ID",
    "keybind": "e",
    "text": "Log out  ·  E"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "keybind": "r",
    "text": "Restart  ·  R"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "keybind": "s",
    "text": "Power off  ·  S"
}
