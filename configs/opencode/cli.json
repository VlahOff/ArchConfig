{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "one-dark",
    "mode": "dark"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.6,
    "sound_pack": "opencode.default"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "tps": true,
    "grouping": "auto",
    "markdown": "rendered",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "auto"
  },
  "prompt": {
    "paste": "full"
  }
}
